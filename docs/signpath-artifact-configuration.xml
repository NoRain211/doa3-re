<!-- The SignPath artifact configuration for .github/workflows/sign-launchers.yml.
     SignPath Foundation requires the product name and version on every signed file. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="doa3-re" product-version="${version}">
      <include path="Launcher.exe" />
      <include path="DOA3.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
